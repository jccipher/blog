{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jccipher-blog-engagement",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://jccipher.github.io,http://localhost:4000,http://127.0.0.1:4000,http://localhost:4173,http://127.0.0.1:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jccipher-blog-engagement",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
